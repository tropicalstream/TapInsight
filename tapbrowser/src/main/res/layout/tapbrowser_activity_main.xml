<com.TapLink.app.BinocularSbsLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Single logical viewport – BinocularSbsLayout draws it twice (L+R). -->
    <FrameLayout
        android:id="@+id/mainContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000">

        <!-- Z-LAYER 0: the WebView. Bottom of the stack. Always
             visible and always interactive (after Phase 2 touch
             routing) for browser scrolling / link tapping. -->
        <com.TapLinkX3.app.DualWebViewGroup
            android:id="@+id/dualWebViewGroup"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="0dp"
            android:layout_margin="0dp"
            android:fitsSystemWindows="true"
            android:background="#000000" />

        <!-- Z-LAYER 1: the unipanel chat-panel overlay. Hosts the
             migrated visionclaw chat ViewPager + HUD + camera
             preview as children. The container stays transparent +
             clickable=false so empty regions pass touches through
             to the WebView underneath; individual widgets consume
             their own taps via clickable=true (routed through the
             cursor-tap pipeline by dispatchUnipanelOverlayTouchIfHit).

             Step 2c.1: HUD strip at the top showing the current
             time. Step 2c.2: a stack of compact mini chat cards
             sits beneath the HUD strip. Both are read-only;
             live data wiring comes in Step 2c.3. -->
        <FrameLayout
            android:id="@+id/unipanelOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:clickable="false"
            android:focusable="false"
            android:visibility="visible">

            <!-- Step 2c.1 HUD strip. Semi-transparent dark
                 background so it stays readable over any browser
                 page; pinned to the top so it doesn't cover
                 article content the user is reading. Width caps
                 at 320dp so it doesn't span the full eye in the
                 binocular display and feel oppressive. -->
            <LinearLayout
                android:id="@+id/unipanelHudStrip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp"
                android:background="#B3000000"
                android:elevation="8dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/unipanelHudTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="--:--"
                    android:textColor="#FFE0F4FF"
                    android:textSize="13sp"
                    android:letterSpacing="0.06"
                    tools:ignore="UnusedAttribute" />

                <!-- Phase 4 — real MIC button (was a 14dp dot in
                     Phase 6 essentials). 36dp tap target with the
                     "MIC" label so it's professional and unambiguous
                     instead of a tiny unlabeled pill. Tap = toggle a
                     real Gemini Live voice session via the bound
                     GeminiVoiceService → GeminiVoicePipeline. The
                     parent HUD strip is also clickable as a generous
                     fallback so a tap anywhere on the clock/strip
                     area still activates voice. Color tints at
                     runtime from HudStateBridge.VoicePhase:
                       IDLE       → muted blue-grey
                       LISTENING  → red
                       THINKING   → amber
                       FOLLOW_UP  → soft red -->
                <TextView
                    android:id="@+id/unipanelVoicePill"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_unipanel_voice_pill"
                    android:gravity="center"
                    android:text="MIC"
                    android:textColor="#FFFFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.08"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Toggle Gemini voice"
                    tools:ignore="UnusedAttribute" />

            </LinearLayout>

            <!-- Step 2c.2 mini chat-card stack. Three compact rows
                 stacked vertically directly under the HUD strip.
                 Alternates assistant / user tinting so the layout
                 reads as a real conversation at a glance. The
                 outer LinearLayout is clickable=false: empty space
                 between cards still falls through to the browser
                 (taps on the cards themselves do nothing yet —
                 these are read-only placeholders; Step 2c.3 wires
                 them to MainViewModel chat events and adds focus +
                 voice routing). Width capped at 340dp so even on a
                 single eye of the binocular display, the cards
                 don't span edge-to-edge. -->
            <LinearLayout
                android:id="@+id/unipanelMiniCardStack"
                android:layout_width="340dp"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="44dp"
                android:orientation="vertical"
                android:clickable="false"
                android:focusable="false"
                android:elevation="8dp">

                <!-- Card 1 — assistant. Top of the stack (most
                     recent assistant reply once 2c.3 lights this
                     up). Placeholder text shows the visual at
                     full-size so we can confirm sizing before any
                     real wiring. -->
                <TextView
                    android:id="@+id/unipanelMiniCard1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_unipanel_mini_card_assistant"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="#FFFFFFFF"
                    android:textSize="13sp"
                    android:lineSpacingExtra="1dp"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:text="Mini card · assistant placeholder. Live chat content lands here in 2c.3."
                    android:clickable="false"
                    android:focusable="false" />

                <!-- Card 2 — user. -->
                <TextView
                    android:id="@+id/unipanelMiniCard2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_unipanel_mini_card_user"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="#FFFFFFFF"
                    android:textSize="13sp"
                    android:lineSpacingExtra="1dp"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:text="Mini card · user placeholder. Your last spoken query will show here."
                    android:clickable="false"
                    android:focusable="false" />

                <!-- Card 3 — assistant (older). -->
                <TextView
                    android:id="@+id/unipanelMiniCard3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_unipanel_mini_card_assistant"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="#FFFFFFFF"
                    android:textSize="13sp"
                    android:lineSpacingExtra="1dp"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:text="Mini card · older assistant reply. Stack scrolls older entries down out of frame."
                    android:clickable="false"
                    android:focusable="false" />

            </LinearLayout>

            <!-- Step 2c.4 camera-status chip. Pinned top-right so it
                 doesn't crowd the HUD clock at top-center. Visible
                 only while voiceAssistantActive is true (Gemini Live
                 listening + camera on). Same dark semi-transparent
                 background as the HUD strip so the two reads as the
                 same surface family. The red dot is a separate View
                 with bg_unipanel_camera_dot so it stays unambiguous
                 even when small. Read-only; the three-state hit-
                 test (Step 2c.2.1) keeps it from leaking taps to
                 browser controls beneath. -->
            <LinearLayout
                android:id="@+id/unipanelCameraChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="14dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp"
                android:background="#B3000000"
                android:elevation="8dp"
                android:clickable="false"
                android:focusable="false"
                android:visibility="gone">

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_unipanel_camera_dot" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="CAM"
                    android:textColor="#FFE0F4FF"
                    android:textSize="11sp"
                    android:letterSpacing="0.12"
                    tools:ignore="UnusedAttribute" />

            </LinearLayout>

        </FrameLayout>

    </FrameLayout>

</com.TapLink.app.BinocularSbsLayout>
