<com.TapLink.app.BinocularSbsLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Single logical viewport – BinocularSbsLayout draws it twice (L+R). -->
    <FrameLayout
        android:id="@+id/mainContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000">

        <!-- Z-LAYER 0: the WebView. Bottom of the stack. Always
             visible and always interactive (after Phase 2 touch
             routing) for browser scrolling / link tapping. -->
        <com.TapLinkX3.app.DualWebViewGroup
            android:id="@+id/dualWebViewGroup"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="0dp"
            android:layout_margin="0dp"
            android:fitsSystemWindows="true"
            android:background="#000000" />

        <!-- Z-LAYER 1: the unipanel chat-panel overlay. Hosts the
             migrated visionclaw chat ViewPager + HUD + camera
             preview as children. The container stays transparent +
             clickable=false so empty regions pass touches through
             to the WebView underneath; individual widgets consume
             their own taps via clickable=true (routed through the
             cursor-tap pipeline by dispatchUnipanelOverlayTouchIfHit).

             Step 2c.1: HUD strip at the top showing the current
             time. Step 2c.2: a stack of compact mini chat cards
             sits beneath the HUD strip. Both are read-only;
             live data wiring comes in Step 2c.3. -->
        <FrameLayout
            android:id="@+id/unipanelOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:clickable="false"
            android:focusable="false"
            android:visibility="visible">

            <!-- Step 2c.1 HUD strip. Semi-transparent dark
                 background so it stays readable over any browser
                 page; pinned to the top so it doesn't cover
                 article content the user is reading. Width matches
                 the mini-card stack so moving the pointer into the
                 HUD lane and tapping is enough to toggle voice. -->
            <LinearLayout
                android:id="@+id/unipanelHudStrip"
                android:layout_width="340dp"
                android:layout_height="48dp"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:background="#B3000000"
                android:elevation="8dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/unipanelHudTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="--:--"
                    android:textColor="#FFE0F4FF"
                    android:textSize="13sp"
                    android:letterSpacing="0.06"
                    tools:ignore="UnusedAttribute" />

                <!-- Date + day-of-week. Updated on the same 30s tick
                     as the clock. Format: "Mon · May 19". Compact so
                     the HUD strip stays narrow. -->
                <TextView
                    android:id="@+id/unipanelHudDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:fontFamily="sans-serif"
                    android:text="—"
                    android:textColor="#FFB7CEDE"
                    android:textSize="11sp"
                    android:letterSpacing="0.04"
                    tools:ignore="UnusedAttribute" />

                <!-- Battery %. Updated on ACTION_BATTERY_CHANGED
                     broadcasts (sticky intent on Android, so we get
                     the current value at registration time too). -->
                <TextView
                    android:id="@+id/unipanelHudBattery"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="—"
                    android:textColor="#FF9FE6B0"
                    android:textSize="11sp"
                    android:letterSpacing="0.04"
                    tools:ignore="UnusedAttribute" />

                <!-- Phase 4f: connectivity indicator. ConnectivityManager
                     callbacks drive this — "WIFI" / "CELL" / "OFF"
                     reflect the current process-active network. Wi-Fi
                     amber, cellular blue, offline red — matches the
                     status-bar convention. -->
                <TextView
                    android:id="@+id/unipanelHudNetwork"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="—"
                    android:textColor="#FFB7CEDE"
                    android:textSize="11sp"
                    android:letterSpacing="0.06"
                    tools:ignore="UnusedAttribute" />

                <!-- Phase 4h — Hermes HUD fields, compressed into the
                     unipanel strip. Ported from the hermes branch's
                     fragment_chat_panel hudContainer block. The
                     visionclaw API clients that drove live AQI /
                     calendar / Hermes status used to fire on a
                     periodic refresh from the Activity; in unipanel
                     mode they're not yet wired (Application-scope
                     viewModel exists but nothing polls). Until the
                     polling is wired in a follow-up these show
                     placeholder values, but the slots are present so
                     the HUD visually matches the Hermes layout. -->

                <!-- AI status badge "G" — tinted from HudStateBridge
                     connection status. Green when Gemini connected,
                     amber while connecting, red on error/idle. -->
                <TextView
                    android:id="@+id/unipanelHudAiBadge"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginStart="10dp"
                    android:gravity="center"
                    android:fontFamily="sans-serif-medium"
                    android:text="G"
                    android:textColor="#FFFFFFFF"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_unipanel_voice_pill"
                    tools:ignore="UnusedAttribute" />

                <!-- AQI text — placeholder "AQI --" until a follow-up
                     wires viewModel.airQualityClient polling. -->
                <TextView
                    android:id="@+id/unipanelHudAqi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="AQI --"
                    android:textColor="#CCFFFFFF"
                    android:textSize="11sp"
                    android:letterSpacing="0.04"
                    tools:ignore="UnusedAttribute" />

                <!-- Hermes server status dot — green if reachable,
                     red if not. Placeholder red (unreachable) until
                     a follow-up wires a Hermes ping. -->
                <View
                    android:id="@+id/unipanelHudHermesDot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_unipanel_camera_dot"
                    android:visibility="visible" />

                <!-- Phase 4 — real MIC button (was a 14dp dot in
                     Phase 6 essentials). 36dp tap target with the
                     "MIC" label so it's professional and unambiguous
                     instead of a tiny unlabeled pill. Tap = toggle a
                     real Gemini Live voice session via the bound
                     GeminiVoiceService → GeminiVoicePipeline. The
                     parent HUD strip is also clickable as a generous
                     fallback so a tap anywhere on the clock/strip
                     area still activates voice. Color tints at
                     runtime from HudStateBridge.VoicePhase:
                       IDLE       → muted blue-grey
                       LISTENING  → red
                       THINKING   → amber
                       FOLLOW_UP  → soft red -->
                <TextView
                    android:id="@+id/unipanelVoicePill"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_unipanel_voice_pill"
                    android:gravity="center"
                    android:text="MIC"
                    android:textColor="#FFFFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.08"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Toggle Gemini voice"
                    tools:ignore="UnusedAttribute" />

                <!-- Phase 4d (Mars revision) — manual CAM toggle
                     removed. Vision is now voice-triggered: when the
                     user says "look at this" / "what does this say" /
                     etc., the pipeline fires browser_vision against
                     the WebView screenshot AND auto-starts CameraX
                     for the rest of the voice session so Gemini has
                     real-world visual context. The red dot below
                     replaces the CAM button — it lights up while
                     vision is active and turns off otherwise.

                     The 8dp × 8dp dot uses the existing camera-dot
                     drawable. Visible only when HudStateBridge says
                     screen-look or camera is active. -->
                <View
                    android:id="@+id/unipanelVisionDot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_unipanel_camera_dot"
                    android:visibility="gone"
                    tools:ignore="UnusedAttribute" />

            </LinearLayout>

            <!-- Step 2c.2 mini chat-card stack. Three compact rows
                 stacked vertically directly under the HUD strip.
                 Alternates assistant / user tinting so the layout
                 reads as a real conversation at a glance. The
                 outer LinearLayout is clickable=false: empty space
                 between cards still falls through to the browser
                 (taps on the cards themselves do nothing yet —
                 these are read-only placeholders; Step 2c.3 wires
                 them to MainViewModel chat events and adds focus +
                 voice routing). Width capped at 340dp so even on a
                 single eye of the binocular display, the cards
                 don't span edge-to-edge. -->
            <!-- Phase 4g (Mars revision, take 2) — ONE chat card,
                 Gemini/TTS output only. Collapsed = 2 lines with
                 ellipsis. Tap = expand to up to 8 lines so the user
                 can read longer Gemini replies in place. Tap again
                 = collapse. No user-side cards, no older-message
                 cards — just the live assistant reply.
                 Phase 4h — marginTop dropped from 64dp to 52dp so
                 the card sits flush under the HUD strip instead of
                 floating mid-screen. The card itself is GONE-when-
                 empty (see renderUnipanelAssistantCard) so cold
                 launch shows zero card-related padding. -->
            <LinearLayout
                android:id="@+id/unipanelMiniCardStack"
                android:layout_width="340dp"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="52dp"
                android:orientation="vertical"
                android:clickable="false"
                android:focusable="false"
                android:elevation="8dp">

                <TextView
                    android:id="@+id/unipanelMiniCard1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_unipanel_mini_card_assistant"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="#FFFFFFFF"
                    android:textSize="13sp"
                    android:lineSpacingExtra="1dp"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:text=""
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Gemini reply — tap to expand" />

            </LinearLayout>

            <!-- Phase 4g — Hermes-style camera preview frame. 96dp ×
                 72dp burgundy-stroked container holding a PreviewView
                 fed by the Service-side CameraX pipeline. Pinned
                 just below the HUD strip, left-aligned with a small
                 inset so it doesn't crowd the chat card. Visible
                 only while CameraX is streaming (CameraStateBridge
                 publishes true). The HUD expands implicitly because
                 the chat card stays anchored at its 64dp marginTop —
                 the preview frame sits to the LEFT of where cards
                 would be, mirroring the Hermes orbColumn layout. -->
            <FrameLayout
                android:id="@+id/unipanelCameraPreviewFrame"
                android:layout_width="96dp"
                android:layout_height="72dp"
                android:layout_gravity="top|start"
                android:layout_marginStart="14dp"
                android:layout_marginTop="60dp"
                android:background="@drawable/bg_unipanel_camera_preview"
                android:padding="4dp"
                android:elevation="10dp"
                android:visibility="gone"
                android:clickable="false"
                android:focusable="false">

                <androidx.camera.view.PreviewView
                    android:id="@+id/unipanelCameraPreviewView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

            </FrameLayout>

            <!-- Phase 4f (Mars revision) — legacy top-right CAM chip
                 deleted. The unipanelVisionDot inside the HUD strip
                 (added Phase 4e) is now the sole vision-active
                 indicator. Two dots firing off the same
                 CameraStateBridge publish read as a bug; one is
                 enough. -->

        </FrameLayout>

    </FrameLayout>

</com.TapLink.app.BinocularSbsLayout>
