<com.TapLink.app.BinocularSbsLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Single logical viewport – BinocularSbsLayout draws it twice (L+R). -->
    <FrameLayout
        android:id="@+id/mainContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000">

        <!-- Z-LAYER 0: the WebView. Bottom of the stack. Always
             visible and always interactive (after Phase 2 touch
             routing) for browser scrolling / link tapping. -->
        <com.TapLinkX3.app.DualWebViewGroup
            android:id="@+id/dualWebViewGroup"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="0dp"
            android:layout_margin="0dp"
            android:fitsSystemWindows="true"
            android:background="#000000" />

        <!-- Z-LAYER 1: the chat-panel overlay. Hosts the migrated
             visionclaw chat ViewPager + HUD + camera preview as
             children in Step 2d+. Stays transparent and
             clickable=false so empty regions pass touches through
             to the WebView underneath; individual chat widgets
             consume their own taps via their own clickable=true.

             Step 2b: shown with a single test pill (top-right) so
             we can verify the tap-consume / tap-passthrough
             contract works correctly before piping real chat
             content in. -->
        <FrameLayout
            android:id="@+id/unipanelOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:clickable="false"
            android:focusable="false"
            android:visibility="visible">

            <!-- Step 2b probe pill. clickable=true so this widget
                 consumes taps on its own bounds. Anywhere else
                 in unipanelOverlay (clickable=false) falls through
                 to the WebView. If you can scroll the browser
                 around this pill, touch routing is correct. -->
            <TextView
                android:id="@+id/unipanelStep2bProbe"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="12dp"
                android:paddingHorizontal="14px"
                android:paddingVertical="8px"
                android:background="#CC003B5C"
                android:clickable="true"
                android:focusable="true"
                android:text="step 2b"
                android:textColor="#FF9EF3FF"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                android:elevation="6dp" />

        </FrameLayout>

    </FrameLayout>

</com.TapLink.app.BinocularSbsLayout>
