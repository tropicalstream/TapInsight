<?xml version="1.0" encoding="utf-8"?>
<!--
    Phase 2 final (unipanel sweep) — minimal stub layout.

    The visible chat UI now lives in tapbrowser's unipanel overlay.
    visionclaw runs as a headless host for MainViewModel, audio
    capture, the Gemini Live session, and the unipanel bridges; the
    user never sees this Activity in the foreground (it warm-starts
    in the background and moveTaskToBack's itself).

    We still need a layout file so MainActivity.setContentView can
    succeed, and the IDs that MainActivity.kt looks up via
    findViewById (view_pager, hud_notification, hold_progress,
    listening_overlay, listening_transcript, voice_oscilloscope,
    custom_keyboard_view) must each resolve to a non-null View so
    the existing init code doesn't NPE. We declare each as a 0×0
    `visibility="gone"` stub of the exact concrete type the code
    expects (ViewPager2 for view_pager, CustomKeyboardView for the
    keyboard, VoiceOscilloscopeView for the oscilloscope, etc.).
    Nothing renders.

    Top-level container remains `BinocularSbsLayout` because
    MainActivity assumes SBS-aware addView behaviour; reducing it
    to a plain FrameLayout would risk subtle differences in onMeasure.
-->
<com.rayneo.visionclaw.ui.BinocularSbsLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    tools:context=".MainActivity">

    <FrameLayout
        android:id="@+id/logical_viewport"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone">

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/view_pager"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/hold_progress"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:max="100"
            android:progress="0"
            android:visibility="gone" />

        <TextView
            android:id="@+id/hud_notification"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/listening_overlay"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/listening_transcript"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />
        </FrameLayout>

        <com.rayneo.visionclaw.ui.CustomKeyboardView
            android:id="@+id/custom_keyboard_view"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <com.rayneo.visionclaw.ui.VoiceOscilloscopeView
            android:id="@+id/voice_oscilloscope"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
    </FrameLayout>

</com.rayneo.visionclaw.ui.BinocularSbsLayout>
